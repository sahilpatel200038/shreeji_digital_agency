{
  "name": "shreeji_new_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "check:links": "tsx scripts/check-links.ts",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "mariadb": "3.5.4",
    "motion": "^14.1.0",
    "next": "16.4.3",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "mariadb": "3.5.4"
  }
}
