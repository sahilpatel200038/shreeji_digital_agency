# Shreeji Marketing: Next.js 16 + Prisma 7 + MySQL. Lockfile (package-lock.json), prisma/migrations and
# .env.example are tracked on purpose. See README.md > Environment.

# --- dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- environment & secrets (never commit real values; copy .env.example to .env) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Next.js build output ---
/.next/
/out/
/build
# isolated build used by the Playwright suite (NEXT_DIST_DIR=.next-e2e)
/.next-e2e/
next-env.d.ts
*.tsbuildinfo

# --- Prisma generated client (created by `prisma generate`, which runs on postinstall) ---
/src/generated

# --- tests & reports ---
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# --- logs, caches, temporary files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.cache/
.turbo/
tmp/
*.tmp
*.pid

# --- editors & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# --- local AI-assistant tooling (not part of the application) ---
.agents
.windsurf
.claude/
skills-lock.json

# --- deployment ---
.vercel

# --- screenshot/dev build output ---
.next-shot/
