# Shreeji Marketing: Next.js 16 + Prisma 7 + MySQL. Lockfile (package-lock.json), prisma/migrations and
# .env.example are tracked on purpose. See README.md > Environment.

# --- dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- environment & secrets (never commit real values; copy .env.example to .env) ---
.env
.env.*
!.env.example
!.env.production.example
!*.local
*.pem
*.key
*.p12

# --- Next.js build output ---
/.next/
/out/
/.next-test/
/.next-test2/
/build
# isolated build used by the Playwright suite (NEXT_DIST_DIR=.next-e2e)
/.next-e2e/
next-env.d.ts
*.tsbuildinfo

# --- Prisma generated client (created by `prisma generate`, which runs on postinstall) ---
/src/generated

# --- tests & reports ---
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# --- logs, caches, temporary files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.cache/
.turbo/
tmp/
*.tmp
*.pid

# --- editors & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# --- local AI-assistant tooling (not part of the application) ---
.agents
.windsurf
.claude/
skills-lock.json

# --- deployment ---
.vercel

# --- screenshot/dev build output ---
.next-shot/

# --- secrets, certificates, database dumps & backups (never commit) ---
*.pfx
*.crt
*.cer
*.der
*.csr
id_rsa*
id_ed25519*
*.p8
*.sql.gz
*.dump
*.bak
*.backup
*.old
*.sqlite
*.sqlite3
*.db
/backup/
/backups/
/dumps/
# loose SQL dumps are ignored, but Prisma migrations are source and must stay tracked
*.sql
!/prisma/migrations/**/*.sql
*.zip
*.tar
*.tar.gz
*.tgz

# --- local debug output (root-level screenshots from scripts/shot.mjs) ---
/shot-*.png

# --- uploads ---
# Admin uploads live in MySQL (Media + MediaBlob), not on disk, so there is no uploads folder to
# ignore or protect. If a file-based upload dir is ever added (e.g. public/uploads), do NOT ignore it
# blindly: it holds production data and must be kept out of the deploy's overwrite/clean step.

# isolated verification build (NEXT_DIST_DIR=.next-verify)
/.next-verify/
