# Production environment template for https://shreejidigitalagency.com
# PLACEHOLDERS ONLY. Never put real values in this file or commit them.
# Enter the real values in Hostinger hPanel > Node.js Web App > Environment variables (or the VPS .env, chmod 600).

# --- Database (MySQL 8) ---
# Copy the exact database name, user and password you created in hPanel > Databases.
# Hostinger databases are usually reached on localhost:3306 from the same hosting account; confirm in hPanel.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"
# Connections each Node process may hold open. Keep (processes x DB_POOL_LIMIT) well under the host's max_user_connections.
DB_POOL_LIMIT=4
# Optional tuning (milliseconds): DB_CONNECT_TIMEOUT_MS=8000  DB_ACQUIRE_TIMEOUT_MS=10000  DB_TRANSACTION_TIMEOUT_MS=15000  DB_HEALTH_TIMEOUT_MS=3000

# --- Security (required; the app refuses to run without them) ---
# Generate each with: openssl rand -base64 48
# Changing AUTH_SECRET logs every admin out. Changing IP_HASH_SALT breaks matching of old hashed IPs.
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_48"
IP_HASH_SALT="CHANGE_ME_openssl_rand_base64_24"

# --- Site (NEXT_PUBLIC_* is baked in at BUILD time: changing it needs a rebuild) ---
NEXT_PUBLIC_SITE_URL="https://shreejidigitalagency.com"
ALLOW_INDEXING="true"
NODE_ENV="production"
APP_TIMEZONE="Asia/Kolkata"

# --- First deployment only: seed the admin user, then DELETE these two lines ---
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD="MIN_12_CHARS_THEN_REMOVE"

# Not needed in production: SHADOW_DATABASE_URL, TEST_DATABASE_URL
