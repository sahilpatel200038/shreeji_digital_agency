# --- Database (MySQL 8) ---
DATABASE_URL="mysql://shreeji_site:CHANGE_ME@localhost:3306/shreeji_marketing"
# Only needed for `prisma migrate dev` (local development)
SHADOW_DATABASE_URL="mysql://shreeji_site:CHANGE_ME@localhost:3306/shreeji_marketing_shadow"
DB_POOL_LIMIT=5

# --- Security ---
# Generate with: openssl rand -base64 48   (>= 32 chars, never commit the real value)
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
IP_HASH_SALT="CHANGE_ME_RANDOM_SALT"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "false" on staging to emit Disallow: / and noindex
ALLOW_INDEXING="true"

# --- First-run seed only (remove after seeding) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_MIN_12_CHARS"

# Integration tests only: separate schema, never the dev/prod DB
TEST_DATABASE_URL="mysql://shreeji_site:CHANGE_ME@localhost:3306/shreeji_marketing_test"
